#!/bin/sh

start_once() {
  command -v "$1" >/dev/null 2>&1 || return 0
  pgrep -u "$USER" -x "$1" >/dev/null 2>&1 || "$@" &
}

# Fluxbox is started from a TTY, so load Home Manager's X resources here.
xrdb -merge "$HOME/.Xresources"

# Fluxbox's toolbar owns the system tray.
start_once dunst
start_once diodon
start_once blueman-applet
start_once pasystray
start_once upowertray
start_once gkrellm -w
start_once wmbubble

feh --no-fehbg --xinerama-index 0 --bg-max --image-bg '#333333' \
  "$HOME/.local/share/wallpapers/linux.png" &

exec fluxbox
