#!/bin/sh

# TTY-launched sessions do not process XDG autostart files.
fluxbox-wayland --terminal kitty &
fluxbox_pid=$!

sleep 2

start_once() {
  command -v "$1" >/dev/null 2>&1 || return 0
  pgrep -u "$USER" -x "$1" >/dev/null 2>&1 || "$@" &
}

# Status applets and notifications.
start_once dunst
start_once nm-applet --indicator
start_once blueman-applet
start_once diodon
start_once pasystray
start_once upowertray

# Legacy dockapps use XWayland.
wait "$fluxbox_pid"
